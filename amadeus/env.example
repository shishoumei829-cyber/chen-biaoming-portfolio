# 复制为 .env 或在本机「用户环境变量」中配置（Ollama 相关变量需作用于运行 ollama serve 的进程）
# 详见 docs/GPU_OLLAMA_SOVITS.md

# --- Amadeus 后端（Node server.js）---
# 服务端口（Electron 与后端需一致）
# AMADEUS_BACKEND_PORT=3000

# 8GB 显存友好：默认已在代码里设为 2048 / 6000，此处仅覆盖
# 1=主对话轻量路径（默认）；0=恢复周期元认知洞察等
# 高亲密度模式（默认开；设为 0 关闭）
AMADEUS_HIGH_INTIMACY=1
# 对话对象：okabe（默认冈部伦太郎）；custom=仅依赖 whoami 档案，不自动认定冈部
AMADEUS_PARTNER_ID=okabe
# 剧情认知上限（默认 full=与改前相同，用整份 soul）。仅在做实验时设 lab_early|alpha|beta|sg
# AMADEUS_PROGRESS_STAGE=lab_early
# 设为 0 可关闭阶段裁剪与剧透块（等同始终 full）
# AMADEUS_STORY_STAGE=0
# 设为 0 可关闭对话沉淀规则注入
# AMADEUS_MEMORY_SEDIMENT=0

# 启动时把 whoami 写成冈部档案（0 关闭）
# AMADEUS_PARTNER_BOOTSTRAP=1

AMADEUS_CHAT_MINIMAL=1
# 情绪/追问类轮次同步等一轮 BDI 心智读数（略增延迟，更像「先想再回」）
# AMADEUS_SYNC_MIND_READ=1
AMADEUS_OLLAMA_NUM_CTX=2048
AMADEUS_MAX_PROMPT_CHARS=6000
# 主对话模型（须与 ollama list 一致）
# AMADEUS_CHAT_MODEL=kurisu:latest

# --- 工作脑（云端强推理；日常陪伴仍走本地 kurisu）---
# off | deepseek | gemini | openai | ollama | auto
#
# 【推荐】DeepSeek（复制本文件为 .env 后填写，勿把 Key 提交 Git）：
# AMADEUS_WORK_BRAIN=deepseek
# AMADEUS_OPENAI_API_KEY=sk-你的DeepSeek密钥
# AMADEUS_WORK_OPENAI_BASE=https://api.deepseek.com/v1
# AMADEUS_WORK_OPENAI_MODEL=deepseek-chat
# 难题改 reasoner：AMADEUS_WORK_OPENAI_MODEL=deepseek-reasoner
# 或保持 chat 并设 AMADEUS_WORK_USE_REASONER=1
#
# Gemini：
# AMADEUS_WORK_BRAIN=gemini
# AMADEUS_GEMINI_API_KEY=你的_Google_AI_Studio_Key
# AMADEUS_GEMINI_MODEL=gemini-2.0-flash
# 无云端 Key 时用本地大模型当工作脑：
# AMADEUS_WORK_BRAIN=ollama
# AMADEUS_WORK_OLLAMA_MODEL=qwen2.5:14b
# AMADEUS_WORK_MAX_TOKENS=2048
# AMADEUS_WORK_TIMEOUT_MS=90000
# 1=自动识别工作类问题（写代码、分析、翻译等）；0=仅 @工作 或 brainMode:work 时启用
# AMADEUS_WORK_AUTO=1

# --- Skills（与 Cursor SKILL.md 同结构，见 skills/README.md）---
# AMADEUS_SKILLS=1
# AMADEUS_SKILLS_MAX=2
# AMADEUS_SKILLS_CHARS=1400
# AMADEUS_SKILLS_USER=1
# 多轮对话发往 Ollama 时最多保留几条消息（user+assistant 合计，不含 system）；过大易挤爆 num_ctx
# AMADEUS_CHAT_HISTORY_MSGS=24
AMADEUS_OLLAMA_BASE=http://127.0.0.1:11434
# Ollama 模型常驻时间，8GB 建议 2m，避免长期占满与 SoVITS 抢显存
AMADEUS_OLLAMA_KEEP_ALIVE=2m

# --- Ollama 服务进程（须在启动 ollama 前设置，或写入系统用户环境变量后重启 Ollama）---
OLLAMA_NUM_GPU=999
OLLAMA_FLASH_ATTENTION=1

# --- SoVITS 语音（可选；/tts 400 多半是缺 ref.wav）---
AMADEUS_SOVITS_URL=http://localhost:9880
# GPT-SoVITS 安装目录（目录里要有 ref.wav，及 ref_angry.wav 等若用多情绪）
# AMADEUS_SOVITS_ROOT=D:\GPT-SoVITS
# 或直接写参考音频绝对路径：
# AMADEUS_SOVITS_REF=D:\GPT-SoVITS\ref.wav

# --- Electron（可选）---
# AMADEUS_AUTO_LAUNCH=1
# AMADEUS_DEBUG=1
