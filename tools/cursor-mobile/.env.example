# 从 https://cursor.com/dashboard → Integrations → User API Keys 生成
CURSOR_API_KEY=

# local = 操作电脑本地项目（My Machines）；cloud = 操作 GitHub 云端虚拟机
AGENT_TARGET=local

# 本地 worker 名称（与 agent worker start --name 一致）
WORKER_NAME=shikimori-desktop

# worker 监听的本地项目目录
WORKER_DIR=C:\Users\SHIKIMORI\Desktop\个人网站

# cloud 模式用的 GitHub 仓库
CURSOR_REPO_URL=https://github.com/shishoumei829-cyber/chen-biaoming-portfolio.git
CURSOR_REPO_BRANCH=main

# 手机访问本服务时的简单口令（自己设一个长一点的）
ACCESS_TOKEN=change-me-to-a-long-random-string

# 监听端口
PORT=4789

# 监听地址：0.0.0.0 允许局域网/ Tailscale 访问；127.0.0.1 仅本机
HOST=0.0.0.0
